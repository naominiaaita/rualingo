<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background (Track) -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="@color/ui_border_light" />
        </shape>
    </item>
    <!-- Progress Layer -->
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <!-- Shadow/Bottom of Progress -->
                <item>
                    <shape>
                        <corners android:radius="8dp" />
                        <solid android:color="@color/ui_orange_dark" />
                    </shape>
                </item>
                <!-- Top part of Progress -->
                <item android:bottom="4dp">
                    <shape>
                        <corners android:radius="8dp" />
                        <solid android:color="@color/ui_orange_main" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
