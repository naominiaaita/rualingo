<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_off_white"
    android:fitsSystemWindows="true">

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/completionImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/rualingo_logo" />

        <TextView
            android:id="@+id/completionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/lesson_complete"
            android:textColor="@color/ui_orange_main"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/completionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/you_finished_the_lesson"
            android:textColor="@color/duo_text_gray"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>

    <!-- Bottom Action Section (Duolingo Style) -->
    <FrameLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/finishButton"
            style="@style/DuolingoButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/finish"
            app:backgroundTint="@color/ui_orange_main"
            app:strokeColor="@color/ui_orange_dark"
            app:strokeWidth="4dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
